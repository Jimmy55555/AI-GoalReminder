<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    keyframes: {
                        'orbit-a': {
                            '0%': { transform: 'translate3d(0, 0, 0) scale(1)' },
                            '25%': { transform: 'translate3d(55vw, 8vh, 0) scale(1.15)' },
                            '50%': { transform: 'translate3d(35vw, 52vh, 0) scale(0.9)' },
                            '75%': { transform: 'translate3d(-8vw, 34vh, 0) scale(1.1)' },
                            '100%': { transform: 'translate3d(0, 0, 0) scale(1)' }
                        },
                        'orbit-b': {
                            '0%': { transform: 'translate3d(0, 0, 0) scale(1.1)' },
                            '25%': { transform: 'translate3d(-45vw, 26vh, 0) scale(0.9)' },
                            '50%': { transform: 'translate3d(-18vw, -12vh, 0) scale(1.2)' },
                            '75%': { transform: 'translate3d(28vw, 12vh, 0) scale(1)' },
                            '100%': { transform: 'translate3d(0, 0, 0) scale(1.1)' }
                        }
                    },
                    animation: {
                        'orbit-a': 'orbit-a 17s ease-in-out infinite',
                        'orbit-b': 'orbit-b 21s ease-in-out infinite'
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["長期目標提醒器.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body class="bg-indigo-50 text-slate-900">
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
