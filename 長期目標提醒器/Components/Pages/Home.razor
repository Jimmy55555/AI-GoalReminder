@page "/"
@rendermode InteractiveServer

<PageTitle>長期目標提醒器</PageTitle>

<div class="flex min-h-[calc(100vh-3.5rem)] text-slate-900">
    <GoalSidebar Goals="goals"
                 SelectedGoalId="selectedGoalId"
                 OnGoalSelected="SelectGoal" />

    <main class="min-w-0 flex-1">
        <GoalDashboard Goal="SelectedGoal" />
    </main>
</div>

@code {
    private readonly IReadOnlyList<Goal> goals = GoalSeedData.Goals;
    private Guid selectedGoalId = GoalSeedData.Goals[0].Id;

    private Goal? SelectedGoal => goals.FirstOrDefault(g => g.Id == selectedGoalId);

    private void SelectGoal(Goal goal) => selectedGoalId = goal.Id;
}
