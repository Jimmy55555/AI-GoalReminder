@inherits LayoutComponentBase
@implements IDisposable
@inject SidebarState State
@inject IThemeService Theme
@inject NavigationManager Nav

<div class="relative isolate min-h-screen overflow-x-hidden text-slate-900 dark:text-slate-100">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute inset-0 bg-[linear-gradient(120deg,#eef2ff,#e0f2fe,#ecfeff,#ecfdf5)] dark:bg-[linear-gradient(120deg,#020617,#0f172a,#0c1a2b,#052e2b)]"></div>
        <div class="absolute -left-40 -top-40 h-[40rem] w-[40rem] rounded-full bg-indigo-400/50 dark:bg-indigo-500/30 blur-3xl will-change-transform animate-orbit-a motion-reduce:animate-none"></div>
        <div class="absolute -right-40 top-1/4 h-[38rem] w-[38rem] rounded-full bg-cyan-400/45 dark:bg-cyan-500/25 blur-3xl will-change-transform animate-orbit-b motion-reduce:animate-none"></div>
        <div class="absolute bottom-0 left-1/3 h-[34rem] w-[34rem] rounded-full bg-emerald-300/25 dark:bg-emerald-400/20 blur-3xl will-change-transform animate-orbit-a motion-reduce:animate-none [animation-duration:23s]"></div>
    </div>

    <header class="sticky top-0 z-20 border-b-2 border-white/60 dark:border-white/10 bg-white/40 dark:bg-slate-900/50 shadow-[0_1px_0_rgba(255,255,255,0.6)] dark:shadow-[0_1px_0_rgba(255,255,255,0.05)] backdrop-blur-lg">
        <nav class="mx-auto grid h-14 max-w-full grid-cols-3 items-center px-4 sm:px-6">
            <div class="flex items-center gap-2">
                @if (ShowMobileMenu)
                {
                    <button type="button"
                            class="grid h-10 w-10 place-items-center rounded-lg border border-white/70 dark:border-white/10 bg-white/50 dark:bg-slate-800/60 text-base text-slate-600 dark:text-slate-300 no-underline backdrop-blur transition-colors hover:bg-white/80 dark:hover:bg-slate-700/70 hover:text-slate-900 dark:hover:text-white sm:hidden"
                            aria-label="開啟選單"
                            @onclick="() => State.ToggleMobile()">
                        ☰
                    </button>
                }
                <a href="./" class="flex min-w-0 items-center gap-2 no-underline" aria-label="AI目標提醒首頁">
                    <svg viewBox="0 0 64 64" class="h-8 w-8 shrink-0" aria-hidden="true">
                        <defs>
                            <linearGradient id="logoGoal" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#6366f1" />
                                <stop offset="1" stop-color="#06b6d4" />
                            </linearGradient>
                        </defs>
                        <rect width="64" height="64" rx="16" fill="url(#logoGoal)" />
                        <circle cx="32" cy="32" r="18" fill="none" stroke="#ffffff" stroke-opacity="0.9" stroke-width="4" />
                        <circle cx="32" cy="32" r="9" fill="none" stroke="#ffffff" stroke-opacity="0.75" stroke-width="4" />
                        <circle cx="32" cy="32" r="3.5" fill="#ffffff" />
                    </svg>
                    <span class="hidden truncate font-mono text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 lg:inline">Goal Reminder</span>
                </a>
            </div>

            <div class="flex justify-center">
                <a href="./" class="flex items-center gap-2 no-underline">
                    <span class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">AI目標提醒</span>
                </a>
            </div>

            <div class="flex items-center justify-end gap-2">
                <span class="hidden font-mono text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 md:inline">Goal Tracker</span>
                <button id="theme-toggle"
                        type="button"
                        class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-white/70 dark:border-white/10 bg-white/50 dark:bg-slate-800/60 text-base text-slate-600 dark:text-slate-200 backdrop-blur transition-colors hover:bg-white/80 dark:hover:bg-slate-700/70 hover:text-slate-900 dark:hover:text-white"
                        title="@ThemeToggleLabel"
                        aria-label="@ThemeToggleLabel"
                        @onclick="ToggleThemeAsync">
                    <span class="dark:hidden [font-variant-emoji:text]" aria-hidden="true">&#x2600;&#xFE0E;</span>
                    <span class="hidden dark:block [font-variant-emoji:text]" aria-hidden="true">&#x263D;&#xFE0E;</span>
                </button>
            </div>
        </nav>
    </header>

    <main role="main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isDark;
    private string ThemeToggleLabel => isDark ? "切換淺色模式" : "切換深色模式";

    private bool ShowMobileMenu
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            return relative.Length == 0;
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDark = await Theme.IsDarkAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        await Theme.ToggleAsync();
        isDark = await Theme.IsDarkAsync();
    }
}
