@inherits LayoutComponentBase
@rendermode InteractiveServer
@inject SidebarState State

<div class="relative isolate min-h-screen overflow-x-hidden text-slate-900">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute inset-0 bg-[linear-gradient(120deg,#eef2ff,#e0f2fe,#ecfeff,#ecfdf5)]"></div>
        <div class="absolute -left-40 -top-40 h-[40rem] w-[40rem] rounded-full bg-indigo-400/50 blur-3xl will-change-transform animate-orbit-a motion-reduce:animate-none"></div>
        <div class="absolute -right-40 top-1/4 h-[38rem] w-[38rem] rounded-full bg-cyan-400/45 blur-3xl will-change-transform animate-orbit-b motion-reduce:animate-none"></div>
        <div class="absolute bottom-0 left-1/3 h-[34rem] w-[34rem] rounded-full bg-emerald-300/25 blur-3xl will-change-transform animate-orbit-a motion-reduce:animate-none [animation-duration:23s]"></div>
    </div>

    <header class="sticky top-0 z-20 border-b-2 border-white/60 bg-white/40 shadow-[0_1px_0_rgba(255,255,255,0.6)] backdrop-blur-lg">
        <nav class="mx-auto grid h-14 max-w-full grid-cols-3 items-center px-4 sm:px-6">
            <div class="flex items-center">
                <button type="button"
                        class="grid h-10 w-10 place-items-center rounded-lg border border-white/70 bg-white/50 text-base text-slate-600 no-underline backdrop-blur transition-colors hover:bg-white/80 hover:text-slate-900 sm:hidden"
                        aria-label="開啟選單"
                        @onclick="() => State.ToggleMobile()">
                    ☰
                </button>
            </div>

            <div class="flex justify-center">
                <a href="/" class="flex items-center gap-2 no-underline">
                    <span class="text-xl font-semibold tracking-tight text-slate-900">長期目標提醒器</span>
                </a>
            </div>

            <div class="flex items-center justify-end gap-2">
                <a href="/settings"
                   class="inline-flex items-center gap-1.5 rounded-lg border border-white/70 bg-white/50 px-2.5 py-1 text-xs text-slate-600 no-underline backdrop-blur transition-colors hover:bg-white/80 hover:text-slate-900">
                    <span aria-hidden="true">⚙</span>
                    <span class="hidden sm:inline">設定</span>
                </a>
                <span class="hidden font-mono text-[10px] uppercase tracking-widest text-slate-500 md:inline">Goal Tracker</span>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-300/60 bg-emerald-100/60 px-2 py-0.5 font-mono text-[10px] text-emerald-700 backdrop-blur">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                    LIVE
                </span>
            </div>
        </nav>
    </header>

    <main role="main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
