<div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
    @if (Goal is null)
    {
        <div class="m-4 rounded-xl border border-amber-200/70 bg-amber-100/60 p-4 font-mono text-xs text-amber-700 backdrop-blur" role="alert">
            NO GOAL SELECTED // 請從左側選擇一個目標
        </div>
    }
    else
    {
        <section class="relative mb-5 overflow-hidden rounded-3xl border-2 border-white/60 bg-white/45 p-5 shadow-[0_8px_32px_rgba(31,38,135,0.10)] backdrop-blur-xl sm:p-7">
            <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-indigo-300/40 blur-3xl" aria-hidden="true"></div>

            <div class="relative flex flex-col items-stretch gap-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-[10px] uppercase tracking-widest text-indigo-600">Active Goal</span>
                        <span class="h-px w-6 bg-indigo-300" aria-hidden="true"></span>
                    </div>
                    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">@Goal.Icon @Goal.Title</h1>
                    <p class="mt-2 max-w-xl text-sm leading-relaxed text-slate-600">@Goal.Description</p>
                    <div class="mt-4 flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center gap-1.5 rounded-xl border border-white/70 bg-white/60 px-2.5 py-1 text-xs text-slate-700 shadow-sm backdrop-blur">
                            🎯 @Goal.TargetDate.ToString("yyyy.MM.dd")
                        </span>
                        <span class="inline-flex items-center gap-1.5 rounded-xl border border-indigo-200/60 bg-indigo-50/70 px-2.5 py-1 font-mono text-xs text-indigo-700 backdrop-blur">
                            @(Goal.DaysRemaining >= 0 ? $"剩餘 {Goal.DaysRemaining} 天" : $"已超過 {-Goal.DaysRemaining} 天")
                        </span>
                    </div>
                </div>

                <div class="relative shrink-0 self-center sm:self-auto">
                    <svg viewBox="0 0 128 128" class="h-28 w-28 -rotate-90 sm:h-32 sm:w-32" aria-hidden="true">
                        <defs>
                            <linearGradient id="goalRing" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#6366f1" />
                                <stop offset="100%" stop-color="#06b6d4" />
                            </linearGradient>
                        </defs>
                        <circle cx="64" cy="64" r="52" fill="none" stroke="rgba(99,102,241,0.15)" stroke-width="10" />
                        <circle cx="64" cy="64" r="52" fill="none" stroke="url(#goalRing)" stroke-width="10" stroke-linecap="round"
                                stroke-dasharray="@RingCircumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                stroke-dashoffset="@RingOffset" />
                    </svg>
                    <div class="absolute inset-0 grid place-items-center">
                        <div class="text-center">
                            <span class="block text-2xl font-semibold tabular-nums text-slate-900">@Goal.ProgressPercent<span class="text-sm font-normal text-slate-400">%</span></span>
                            <span class="font-mono text-[9px] uppercase tracking-widest text-slate-400">完成</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="mb-6 grid grid-cols-1 overflow-hidden rounded-2xl border-2 border-white/60 bg-white/45 shadow-[0_8px_32px_rgba(31,38,135,0.08)] backdrop-blur-md sm:grid-cols-3">
            <div class="border-b-2 border-white/50 px-4 py-4 sm:border-b-0 sm:border-r-2 sm:px-5">
                <span class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-slate-500">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>已掌握
                </span>
                <div class="mt-1.5 flex items-baseline gap-1">
                    <span class="text-2xl font-semibold tabular-nums text-slate-900">@Goal.MasteredCount</span>
                    <span class="text-xs text-slate-500">項</span>
                </div>
            </div>
            <div class="border-b-2 border-white/50 px-4 py-4 sm:border-b-0 sm:border-r-2 sm:px-5">
                <span class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-slate-500">
                    <span class="h-1.5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>學習中
                </span>
                <div class="mt-1.5 flex items-baseline gap-1">
                    <span class="text-2xl font-semibold tabular-nums text-slate-900">@Goal.LearningCount</span>
                    <span class="text-xs text-slate-500">項</span>
                </div>
            </div>
            <div class="px-4 py-4 sm:px-5">
                <span class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-slate-500">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400" aria-hidden="true"></span>未開始
                </span>
                <div class="mt-1.5 flex items-baseline gap-1">
                    <span class="text-2xl font-semibold tabular-nums text-slate-500">@Goal.NotStartedCount</span>
                    <span class="text-xs text-slate-500">項</span>
                </div>
            </div>
        </div>

        <div class="mb-3 flex items-end justify-between">
            <div>
                <h2 class="text-[15px] font-semibold tracking-tight text-slate-900">技能與里程碑</h2>
                <p class="mt-0.5 text-xs text-slate-500">共 @Goal.Skills.Count 項技能</p>
            </div>
            <button type="button" disabled
                    class="cursor-not-allowed rounded-lg border border-white/70 bg-white/50 px-3 py-1.5 text-xs text-slate-400 backdrop-blur">
                ＋ 新增技能
            </button>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var skill in Goal.Skills)
            {
                <article class="group rounded-2xl border-2 border-white/60 bg-white/45 p-4 shadow-[0_8px_32px_rgba(31,38,135,0.08)] backdrop-blur-md transition-all duration-200 hover:-translate-y-0.5 hover:border-white/80 hover:bg-white/65 hover:shadow-[0_12px_40px_rgba(79,70,229,0.15)]">
                    <div class="mb-3 flex items-start justify-between gap-2">
                        <h3 class="text-sm font-semibold text-slate-900">@skill.Name</h3>
                        <span class="shrink-0 rounded-full px-2 py-0.5 font-mono text-[10px] @SkillBadgeClass(skill.Status)">
                            @SkillStatusText(skill.Status)
                        </span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-200/70"
                             role="progressbar"
                             aria-valuenow="@skill.Progress" aria-valuemin="0" aria-valuemax="100">
                            <div class="h-full rounded-full @SkillBarClass(skill.Status)" style="width: @skill.Progress%"></div>
                        </div>
                        <span class="w-9 text-right font-mono text-[11px] tabular-nums text-slate-500">@skill.Progress%</span>
                    </div>
                    <p class="mt-2.5 text-xs leading-relaxed text-slate-600">@skill.Note</p>
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Goal? Goal { get; set; }

    private const double RingRadius = 52;
    private const double RingCircumference = 2 * Math.PI * RingRadius;

    private string RingOffset => (RingCircumference * (1 - (Goal?.ProgressPercent ?? 0) / 100.0))
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string SkillStatusText(SkillStatus status) => status switch
    {
        SkillStatus.Mastered => "已掌握",
        SkillStatus.Learning => "學習中",
        _ => "未開始"
    };

    private static string SkillBadgeClass(SkillStatus status) => status switch
    {
        SkillStatus.Mastered => "bg-emerald-100/70 text-emerald-700 ring-1 ring-inset ring-emerald-500/20",
        SkillStatus.Learning => "bg-amber-100/70 text-amber-700 ring-1 ring-inset ring-amber-500/20",
        _ => "bg-slate-200/70 text-slate-500 ring-1 ring-inset ring-slate-400/20"
    };

    private static string SkillBarClass(SkillStatus status) => status switch
    {
        SkillStatus.Mastered => "bg-emerald-500",
        SkillStatus.Learning => "bg-amber-500",
        _ => "bg-slate-400"
    };
}
